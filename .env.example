# ================= Supabase =================
# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" (Project Settings > API) — pode ir ao frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço "service_role" — NUNCA exponha no frontend. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ================= E-mail (camada desacoplada) =================
# Provedor: "resend" ou "smtp"
EMAIL_PROVIDER=resend
# Resend
RESEND_API_KEY=
# Domínio/remetente verificado
EMAIL_FROM="Comunicação Maracás <no-reply@SEU-DOMINIO>"
# SMTP (alternativa ao Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ================= Aplicação =================
# URL pública do sistema (usada em links de convite/recuperação)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fuso oficial (fixo por regra de negócio)
APP_TIMEZONE=America/Sao_Paulo
# Segredo para agendador do resumo diário de atrasos (cron)
CRON_SECRET=
