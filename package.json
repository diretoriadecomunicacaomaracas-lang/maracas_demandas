{
  "name": "maracas-demandas",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Sistema de Gestão de Demandas — Comunicação da Prefeitura de Maracás/BA (MVP)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:seed": "supabase db reset --linked=false",
    "test:local": "tsx tests/run-all.ts && tsx tests/integration/fluxos.test.ts && tsx tests/integration/calendario.test.ts && tsx tests/integration/kanban.test.ts && tsx tests/integration/triagem.test.ts && tsx tests/integration/conteudo.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "tsx": "^4.16.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}